[Service]
Type=oneshot
UMask=0077
RuntimeDirectory=smartparking-vision
RuntimeDirectoryMode=0700
ExecStart=/mnt/new-volume/SmartParking/infra/vision/vision-local-20261104 preparar-directorio-control
