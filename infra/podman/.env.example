# Ajustes locales de Smart Parking.

# Base de datos: aquí se guarda la información; la contraseña es privada.
POSTGRES_DB=smartparking_local
POSTGRES_USER=smartparking_local
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# App: para abrirla solo desde este equipo, conserva la dirección local.
API_HOST=127.0.0.1
API_PORT=8080
API_BIND_ADDRESS=0.0.0.0

# Inicio: normalmente estos datos se dejan como están.
SPRING_PROFILE=local
SPRING_APPLICATION_NAME=smartparking-api

# Sesiones: define cuánto dura el acceso; usa la opción segura solo con HTTPS.
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false

# Correo: si no lo configuras, deja estos datos como están. No compartas la clave.
SMTP_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_PROTOCOL=smtp
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
SMTP_CONNECTION_TIMEOUT=5000
SMTP_READ_TIMEOUT=3000
SMTP_WRITE_TIMEOUT=5000
SMTP_FROM=noreply@smartparking.local
SMTP_TEST_CONNECTION=false
