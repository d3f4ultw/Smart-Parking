FROM python:3.14.7-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VISION_STATE_PATH=/var/lib/smart-parking-vision

WORKDIR /app/vision

COPY apps/vision/requirements-yolo.txt apps/vision/requirements.txt apps/vision/requirements-runtime.txt ./

RUN python -m pip install --no-cache-dir -r requirements-yolo.txt \
    && python -m pip uninstall --yes opencv-python opencv-contrib-python opencv-python-headless opencv-contrib-python-headless

RUN python -m pip install --no-cache-dir -r requirements-runtime.txt \
    && python -c "import importlib.metadata as m; names={d.metadata['Name'].lower().replace('_','-') for d in m.distributions()}; assert 'opencv-python-headless' in names and not ({'opencv-python','opencv-contrib-python','opencv-contrib-python-headless'} & names)"

COPY apps/vision/capture.py apps/vision/detect.py apps/vision/simulation_playback.py \
     apps/vision/smart_parking_client.py apps/vision/temporal_validation.py \
     apps/vision/vision_runtime.py ./

RUN python -m compileall -q .

ENTRYPOINT ["python", "vision_runtime.py"]
