# PostgreSQL local: nombre de base y usuario elegidos para este equipo.
# La contrasena es obligatoria para una instalacion nueva; este ejemplo no contiene una real.
POSTGRES_DB="smart_parking"
POSTGRES_USER="smart_parking"
POSTGRES_PASSWORD=""

# Perfil local de desarrollo. Mailpit recibe el SMTP dentro de Compose.
APP_ENVIRONMENT="development"
# URL publica usada al generar enlaces de la aplicacion.
APP_PUBLIC_URL="http://localhost:3000"

# Duracion positiva de la sesion, en minutos.
SESSION_COOKIE_NAME="smart_parking_session"
SESSION_DURATION_MINUTES="480"

# Segundos entre reenvios; rango validado: 1-86400.
ACTIVACION_REENVIO_COOLDOWN_SEGUNDOS="60"

# Vigencia del enlace de invitacion: de 1 a 168 horas.
ACTIVATION_TOKEN_TTL_HOURS="24"
# Vigencia del desafio temporal: de 5 a 60 minutos.
ACTIVATION_CHALLENGE_TTL_MINUTES="15"

# El remitente .test es reservado y solo se admite en este perfil SMTP local.
CORREO_TRANSPORTE="smtp"
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@example.test"
SMTP_FROM_NAME="Smart Parking"
SMTP_SECURITY="none"
# Tiempo de espera SMTP, en segundos; debe ser positivo.
SMTP_TIMEOUT_SECONDS="10"

# Perfil de produccion: elegir ssl (normalmente 465) o starttls (normalmente 587).
# Inyectar host, usuario, contrasena y remitente desde almacenamiento seguro.
# APP_ENVIRONMENT="production"
# CORREO_TRANSPORTE="smtp"
# SMTP_HOST="smtp.provider.example"
# SMTP_PORT="587"
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# SMTP_FROM_EMAIL="no-reply@example.com"
# SMTP_FROM_NAME="Smart Parking"
# SMTP_SECURITY="starttls"

# Direccion privada Nuxt -> FastAPI usada solo en el servidor; no exponerla en runtimeConfig.public.
NUXT_API_INTERNAL_BASE_URL="http://api-dev:8000"
